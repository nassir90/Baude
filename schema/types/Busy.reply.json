{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "quit's if_idle: commands are running, so it goes on.",
  "properties": {
    "op": {
      "const": "busy",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The sessions running them."
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "Running.json"
      },
      "description": "What they run."
    }
  },
  "required": ["op"],
  "additionalProperties": false
}
