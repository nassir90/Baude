{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "Its sender store.",
  "properties": {
    "op": {
      "const": "senders",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "session": {
      "type": "string",
      "description": "The session's id."
    },
    "senders": {
      "type": "object",
      "additionalProperties": {
        "$ref": "StoredSender.json"
      },
      "description": "By message uuid."
    },
    "rev": {
      "type": "integer",
      "description": "Its revision."
    }
  },
  "required": ["op", "session"],
  "additionalProperties": false
}
