{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "queue's answer.",
  "properties": {
    "op": {
      "const": "queue",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "session": {
      "type": "string",
      "description": "The session's id."
    },
    "queue": {
      "$ref": "ChatQueue.json",
      "description": "Its queue as kept now."
    }
  },
  "required": ["op", "session", "queue"],
  "additionalProperties": false
}
