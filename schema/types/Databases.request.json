{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "The running databases, read-only: their servers and databases (servers), one database's schema (schema), a table's first rows (rows). Secret-looking columns are masked here.",
  "properties": {
    "op": {
      "const": "databases",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "what": {
      "enum": ["servers", "schema", "rows"],
      "description": "What to read."
    },
    "container": {
      "type": "string",
      "description": "schema, rows: the server's container."
    },
    "database": {
      "type": "string",
      "description": "schema, rows: the database."
    },
    "schema": {
      "type": "string",
      "description": "rows: the table's schema."
    },
    "table": {
      "type": "string",
      "description": "rows: the table."
    }
  },
  "required": ["op"],
  "additionalProperties": false
}
