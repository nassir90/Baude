{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "The task's run a chat was started by (Session's task_run), on its Bot's host.",
  "properties": {
    "bot": {
      "type": "string",
      "description": "The Bot's session id."
    },
    "task": {
      "type": "string",
      "description": "The task's id."
    },
    "run": {
      "type": "string",
      "description": "The run's id."
    },
    "name": {
      "type": "string",
      "description": "The task's name as it ran."
    }
  },
  "required": [
    "bot",
    "task",
    "run"
  ],
  "additionalProperties": false
}
