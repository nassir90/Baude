{
  "type": "object",
  "description": "A message held for a session dropped, or sent as input would send it, from its sender.",
  "properties": {
    "op": {
      "const": "held",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "session": {
      "type": "string",
      "description": "The session's id."
    },
    "id": {
      "type": "string",
      "description": "The held message's id."
    },
    "send": {
      "type": "boolean",
      "description": "Sent, not dropped."
    }
  },
  "required": ["op", "session", "id"],
  "additionalProperties": false
}
