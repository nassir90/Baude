{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "A member deactivated here: its links let go of and not made, its joins and tunnels refused.",
  "properties": {
    "op": {
      "const": "deactivate",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "id": {
      "type": "string",
      "description": "Its id."
    },
    "where": {
      "$ref": "Where.json",
      "description": "Where a link goes."
    }
  },
  "required": ["op"],
  "additionalProperties": false
}
