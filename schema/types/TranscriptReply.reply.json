{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "Whole lines of its transcript, as they are, byte for byte.",
  "properties": {
    "op": {
      "const": "transcript",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "session": {
      "type": "string",
      "description": "The session's id."
    },
    "offset": {
      "type": "integer",
      "description": "Where data starts."
    },
    "next": {
      "type": "integer",
      "description": "Where the next read starts."
    },
    "size": {
      "type": "integer",
      "description": "The transcript's size."
    },
    "data": {
      "type": "string",
      "contentEncoding": "base64",
      "description": "The lines."
    }
  },
  "required": ["op", "session"],
  "additionalProperties": false
}
