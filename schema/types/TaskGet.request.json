{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "One of a Bot's tasks, its script and latest runs.",
  "properties": {
    "op": {
      "const": "task",
      "description": "What it is."
    },
    "req": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "session": {
      "type": "string",
      "description": "The session's id."
    },
    "id": {
      "type": "string",
      "description": "The task's id."
    }
  },
  "required": [
    "op",
    "session",
    "id"
  ],
  "additionalProperties": false
}
