{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "agent's answer.",
  "properties": {
    "op": {
      "const": "agent_started",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "run": {
      "type": "string",
      "description": "The run's id."
    }
  },
  "required": ["op"],
  "additionalProperties": false
}
