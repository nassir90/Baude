{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "What the terminal's program wrote, as it came (its escapes too), base64.",
  "properties": {
    "op": {
      "const": "terminal_out",
      "description": "What it is."
    },
    "req": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "data": {
      "type": "string",
      "description": "The bytes, base64."
    }
  },
  "required": [
    "op"
  ],
  "additionalProperties": false
}
