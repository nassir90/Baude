{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "routines' and run_routine's answer: a Bot's routines.",
  "properties": {
    "op": {
      "const": "routines",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "session": {
      "type": "string",
      "description": "The session's id."
    },
    "routines": {
      "type": "array",
      "items": {
        "$ref": "Routine.json"
      },
      "description": "Its routines."
    },
    "clock": {
      "$ref": "Clock.json",
      "description": "The host's clock."
    }
  },
  "required": ["op", "session"],
  "additionalProperties": false
}
