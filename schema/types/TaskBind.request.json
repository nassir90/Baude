{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "One of a Bot's task's variables bound (binding), or let go of (none): answered as task is, with the variable's warning as it's looked at now.",
  "properties": {
    "op": {
      "const": "task_bind",
      "description": "What it is."
    },
    "req": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "session": {
      "type": "string",
      "description": "The session's id."
    },
    "id": {
      "type": "string",
      "description": "The task's id."
    },
    "name": {
      "type": "string",
      "description": "The variable's name."
    },
    "binding": {
      "anyOf": [
        {
          "$ref": "TaskBinding.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "What it's bound to; none: unbound."
    }
  },
  "required": [
    "op",
    "session",
    "id",
    "name"
  ],
  "additionalProperties": false
}
