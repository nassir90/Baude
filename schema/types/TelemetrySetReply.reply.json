{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "telemetry_set's answer: the host's telemetry state now.",
  "properties": {
    "op": {
      "const": "telemetry_set",
      "description": "What it is."
    },
    "req": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "state": {
      "$ref": "TelemetryState.json",
      "description": "Its telemetry state."
    }
  },
  "required": [
    "op",
    "state"
  ],
  "additionalProperties": false
}
