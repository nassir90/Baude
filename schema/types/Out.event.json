{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "What an agent's program says, on stdout.",
  "properties": {
    "op": {
      "const": "out",
      "description": "What it is."
    },
    "line": {
      "type": "string",
      "description": "The line."
    }
  },
