{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "A checkout's branch.",
  "properties": {
    "name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Its name."
    },
    "upstream": {
      "type": [
        "string",
        "null"
      ],
      "description": "What it tracks."
    },
    "ahead": {
      "type": "integer",
      "description": "Commits ahead of it."
    },
    "behind": {
      "type": "integer",
      "description": "Commits behind it."
    },
    "rev": {
      "type": "string",
      "description": "What names it to git."
    },
    "label": {
      "type": "string",
      "description": "How the branch list names it."
    },
    "sha": {
      "type": [
        "string",
        "null"
      ],
      "description": "Its tip."
    },
    "gone": {
      "type": "boolean",
      "description": "Its upstream is gone from the remote."
    },
    "worktree": {
      "type": [
        "string",
        "null"
      ],
      "description": "The checkout it's in."
    },
    "remote": {
      "type": "boolean",
      "description": "A remote branch."
    },
    "touched": {
      "type": "boolean",
      "description": "This chat touched it (the list's first part)."
    }
  },
  "additionalProperties": false
}
