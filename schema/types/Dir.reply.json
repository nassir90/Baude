{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "list_dir's answer: its entries, folders first (.git left out), DIR_LIMIT at most.",
  "properties": {
    "op": {
      "const": "dir",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "path": {
      "type": "string",
      "description": "The folder."
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "DirEntry.json"
      },
      "description": "Its entries."
    },
    "more": {
      "type": "boolean",
      "description": "There are more."
    },
    "error": {
      "type": "string",
      "description": "Why it can't be read."
    }
  },
  "required": ["op"],
  "additionalProperties": false
}
