{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "What a task's variable of a type could be bound to, as the Bot's host has them.",
  "properties": {
    "op": {
      "const": "task_choices",
      "description": "What it is."
    },
    "req": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "session": {
      "type": "string",
      "description": "The session's id."
    },
    "type": {
      "enum": [
        "model",
        "decider",
        "host",
        "browser_host",
        "terminal_host",
        "kube_context",
        "pod",
        "container",
        "database",
        "text"
      ],
      "description": "The variable's type (TaskVariable's)."
    }
  },
  "required": [
    "op",
    "session",
    "type"
  ],
  "additionalProperties": false
}
