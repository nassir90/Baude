{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "theme_remove's answer: what it had.",
  "properties": {
    "op": {
      "const": "theme_remove",
      "description": "What it is."
    },
    "req": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "before": {
      "anyOf": [
        {
          "$ref": "ThemeFiles.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Its files, or null if it wasn't there."
    }
  },
  "required": [
    "op"
  ],
  "additionalProperties": false
}
