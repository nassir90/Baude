{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "The tool's answer.",
  "properties": {
    "op": {
      "const": "multiplex",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "result": {
      "type": "object",
      "description": "What the terminals' process answered."
    }
  },
  "required": ["op"],
  "additionalProperties": false
}
