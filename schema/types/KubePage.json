{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "A kind's page of the Kubernetes view.",
  "properties": {
    "title": {
      "type": "string",
      "description": "Its name, as the sidebar has it."
    },
    "resource": {
      "type": "string",
      "description": "What kubectl gets it by."
    },
    "crd": {
      "type": ["string", "null"],
      "description": "A custom resource's definition (plural.group), or null."
    },
    "namespaced": {
      "type": "boolean",
      "description": "Its objects are in namespaces."
    },
    "served": {
      "type": "boolean",
      "description": "The cluster serves it."
    },
    "optional": {
      "type": "boolean",
      "description": "Listed only on a cluster that serves it."
    },
    "source": {
      "type": "string",
      "description": "kubectl, secrets or helm."
    }
  },
  "required": ["title", "resource"],
  "additionalProperties": false
}
