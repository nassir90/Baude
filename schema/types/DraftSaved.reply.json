{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "draft_save's answer.",
  "properties": {
    "op": {
      "const": "draft_saved",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "session": {
      "type": "string",
      "description": "The session's id."
    },
    "draft": {
      "$ref": "ChatDraft.json",
      "description": "Its draft as kept now."
    }
  },
  "required": ["op", "session", "draft"],
  "additionalProperties": false
}
