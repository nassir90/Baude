{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "task_run's and task_stop's answer.",
  "properties": {
    "op": {
      "const": "task_run",
      "description": "What it is."
    },
    "req": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "session": {
      "type": "string",
      "description": "The session's id."
    },
    "run": {
      "$ref": "TaskRun.json",
      "description": "The run."
    },
    "log": {
      "type": "array",
      "items": {
        "$ref": "TaskLogLine.json"
      },
      "description": "Its log (its last 2000 lines)."
    },
    "bot": {
      "type": [
        "string",
        "null"
      ],
      "description": "Its Bot's name."
    }
  },
  "required": [
    "op",
    "session",
    "run"
  ],
  "additionalProperties": false
}
