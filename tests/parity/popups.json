    {"name": "pop-home-view-menu", "what": "Home's group-by ⋮ (two groups made)", "where": "Home, ⋮ beside Search sessions (Group by)", "kind": "menu", "as": "home", "steps": [["code", "groups"], ["desc", "Group by"]]},
