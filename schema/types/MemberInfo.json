{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "Who a member is, in its record.",
  "properties": {
    "id": {
      "type": "string",
      "description": "Its id."
    },
    "name": {
      "type": "string",
      "description": "Its name."
    },
    "group": {
      "type": "string",
      "description": "Its group."
    },
    "host": {
      "type": "string",
      "description": "Its machine's host name."
    },
    "version": {
      "type": "integer",
      "description": "Its wire version."
    },
    "bonjour": {
      "type": "string",
      "description": "Its name on the local network."
    },
    "dial": {
      "type": "boolean",
      "description": "false: it can't be linked to, only from (a phone, with no sshd)."
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "Provider.json"
      },
      "description": "Its model providers."
    },
    "commit": {
      "type": ["string", "null"],
      "description": "The commit its code is (null: not a checkout, or it didn't say)."
    },
    "made": {
      "type": ["integer", "null"],
      "description": "When that commit was made, in seconds (null: not known)."
    },
    "heads": {
      "type": "array",
      "items": {
        "$ref": "Head.json"
      },
      "description": "The apps on its machine connected to it, by the code they run."
    }
  },
  "required": ["id"],
  "additionalProperties": false
}
