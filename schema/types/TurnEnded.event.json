{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "A session's turn ended.",
  "properties": {
    "op": {
      "const": "turn_ended",
      "description": "What it is."
    },
    "session": {
      "type": "string",
      "description": "The session's id."
    },
    "uuid": {
      "type": ["string", "null"],
      "description": "The uuid of the message it ended with (its listing's ended's: what a notification of it is known by); null for a chat that keeps no turn's end (ended)."
    },
    "size": {
      "type": ["integer", "null"],
      "description": "Its transcript's size as it ended (its listing's ended's)."
    },
    "result": {
      "type": ["string", "null"],
      "description": "Its result."
    },
    "is_error": {
      "type": "boolean",
      "description": "It ended in an error."
    },
    "cost": {
      "type": ["number", "null"],
      "description": "Its cost, USD."
    },
    "turns": {
      "type": ["integer", "null"],
      "description": "Its turns."
    },
    "duration_ms": {
      "type": ["number", "null"],
      "description": "How long it took."
    }
  },
  "required": ["op", "session"],
  "additionalProperties": false
}
