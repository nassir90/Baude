{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "One of this machine's models' files, or where they are (modelfiles.serve), read-only.",
  "properties": {
    "op": {
      "const": "files",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "method": {
      "type": "string",
      "description": "Its method."
    },
    "path": {
      "type": "string",
      "description": "Its path."
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Its headers."
    }
  },
  "required": ["op"],
  "additionalProperties": false
}
