{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "A file in one of the host's sessions' folders.",
  "properties": {
    "op": {
      "const": "read_file",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "path": {
      "type": "string",
      "description": "Its absolute path."
    },
    "limit": {
      "type": "integer",
      "description": "This much at most."
    }
  },
  "required": ["op"],
  "additionalProperties": false
}
