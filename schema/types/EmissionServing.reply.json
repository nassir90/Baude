{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "emission_serve's answer.",
  "properties": {
    "op": {
      "const": "emission_serving",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "bot": {
      "type": "string",
      "description": "The Bot's id."
    },
    "on": {
      "type": "boolean",
      "description": "Its requests come here."
    }
  },
  "required": ["op"],
  "additionalProperties": false
}
