{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "access_set's answer: the rules as they are now.",
  "properties": {
    "op": {
      "const": "access_set",
      "description": "What it is."
    },
    "req": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "state": {
      "$ref": "AccessState.json",
      "description": "The host's rules now."
    },
    "session": {
      "type": [
        "string",
        "null"
      ],
      "description": "The chat asked about."
    },
    "chat": {
      "anyOf": [
        {
          "$ref": "AccessRule.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "That chat's own rule for managing it (null: the host's manage rule)."
    }
  },
  "required": [
    "op",
    "state"
  ],
  "additionalProperties": false
}
