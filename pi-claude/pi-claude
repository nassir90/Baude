#!/usr/bin/env python3
"""pi-claude: stands in for `claude -p --input-format stream-json --output-format stream-json ...` for Baude, running
pi (the coding agent, in its RPC mode) on a model on this Mac: one MLX serves (models.json), or one Ollama or an
OpenAI-compatible server serves (ollama/<name>, openai/<endpoint>/<id>: baudelib.providers says where, and what it can
do), pi talking to the server's API (openai-completions).

Of the flags Baude passes it uses --model (a value in models.json, or a served model's), --resume (pi's session of that id, kept in
~/.local/share/baude/pi/sessions), --effort (the thinking level, for a model that thinks) and --permission-mode. pi
starts with the first message and stops with this. Each of pi's tool calls is put to Baude as a permission question,
through ask.ts (a pi extension), and shown to it as Claude's tool of that kind (bash as Bash, read as Read, ...).

As claude does for Meta, it also takes --system-prompt (pi's, in place of its own), --tools (Claude's tools, as pi's),
--mcp-config (stdio servers, whose tools pi calls through its own MCP support, named mcp__<server>__<tool> as
Claude's are) and --no-session-persistence (a session pi doesn't keep).

Every chat on an MLX model, in every Baude window, shares one server: `pi-claude --serve` keeps mlx_vlm.server, which
holds one model at a time (16 GB holds no more), behind a gate on PORT: a request for the model it has goes ahead, one
for another waits for those running to finish (a swap stops what's generating). The first chat to need it starts it;
it unloads the model after UNLOAD_AFTER without a request, and stops IDLE after the last chat on a local model has gone.

A served model's server is its own: Ollama's or the endpoint's, there or not (said as the turn's error). Ollama's model
is loaded as the session starts, and its window is then the one Ollama loaded it with (/api/ps): pi's, and what
get_context_usage says. Asked that before it's started, it says the window the model would have (its num_ctx, else
Ollama's least), and, for a caller that gives the whole system prompt (Meta: its first message is made to fit the
window, and comes next), it starts first, so the window's the one it has. A model that can't call tools only talks: pi
gets none, and the chat's told.
"""
import contextlib
import fcntl
import http.client
import http.server
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request
import uuid

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.dirname(HERE))  # (baudelib, beside pi-claude/: where a served model is)
from baudelib import providers  # noqa: E402
HOME = os.path.expanduser("~/.local/share/baude/pi")
PI = os.environ.get("BAUDE_PI") or os.path.join(HOME, "node_modules", ".bin", "pi")
MODELS = {m["value"]: m for m in providers.modelslib.mlx_list()}  # (models.json's, and those settings.json adds)
CONTEXT = 32768  # (the window pi is told: these models take more, but not in 16 GB beside everything else)
MAX_OUT = 4096
MAX_OUT_THINKING = 16384  # (thinking and answer share it: pi's high budget, less 1024 for the answer)
PORT = int(os.environ.get("BAUDE_MLX_PORT") or 48151)
RUN = os.path.join(HOME, "run")  # (the server's keeper: server.json; the chats using it: users/<pid>)
IDLE = 60
UNLOAD_AFTER = 600
LEVELS = ("off", "minimal", "low", "medium", "high")
MCP_TIMEOUT = 900  # (s an MCP tool's call may take: one of Meta's waits on a model loaded, or on the user's answer)
SMALL_WINDOW = 8192  # (a served model's window with less than this has no room for pi's instructions and tools)


def flag(name):
    args = sys.argv[1:]
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else None


model = providers.resolve(flag("--model") or "") or MODELS.get(flag("--model") or "") or next(iter(MODELS.values()))
kind = model.get("kind") or "mlx"  # (mlx; or ollama, openai: a served model, its server its own)
window = model.get("window") or CONTEXT  # (its context window: a served model's, Ollama's once it's loaded)
session_id = flag("--resume") or str(uuid.uuid4())


def level(effort):
    """Baude's effort as pi's thinking level (Claude's xhigh and max as high); off for a model that doesn't think."""
    if not model.get("thinking"):
        return "off"
    effort = {"xhigh": "high", "max": "high"}.get(effort, effort)
    return effort if effort in LEVELS else "off"


thinking = level(flag("--effort"))
mode = {"manual": "default", None: "default"}.get(flag("--permission-mode"), flag("--permission-mode"))
RELAY = os.environ.get("BAUDE_PI_RELAY") == "1"  # (run on another host as an agent: pi's session sent to the
# chat's host as it's written, session.ts)
cwd = os.environ.get("BAUDE_TOOLS_CWD") or os.getcwd()  # (run on another host as an agent: the chat's folder
# there, where its tools work, mcp__host__*; this one, os.getcwd(), an empty one of its own)
system_prompt = flag("--system-prompt")
keep_session = "--no-session-persistence" not in sys.argv
PI_TOOLS = {"Read": "read", "Bash": "bash", "Edit": "edit", "MultiEdit": "edit", "Write": "write", "Grep": "grep",
            "Glob": "find", "LS": "ls"}  # (Claude's tools as pi's)


def mcp_servers():
    """--mcp-config's stdio servers ({name: {command, args, env}}), from its JSON or the file it names."""
    raw = flag("--mcp-config")
    if not raw:
        return {}
    try:
        cfg = json.loads(raw) if raw.lstrip().startswith("{") else json.load(open(raw))
    except (OSError, ValueError):
        say("pi-claude: --mcp-config isn't JSON, nor a file of it")
        return {}
    return {name: server for name, server in (cfg.get("mcpServers") or {}).items() if server.get("command")}


def pi_tools(servers):
    """--tools as pi's (None: pi's own), with each MCP server's (mcp__<server>__*), declared to the model."""
    asked = flag("--tools")
    if asked is None:
        return None
    names = [PI_TOOLS[t.strip()] for t in asked.split(",") if t.strip() in PI_TOOLS]
    return list(dict.fromkeys(names + [f"mcp__{name}__*" for name in servers]))

out_lock = threading.Lock()


def emit(obj):
    with out_lock:
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()


def say(text):
    """A line in Baude's chat (it shows a program's stderr as a note)."""
    sys.stderr.write(text + "\n")
    sys.stderr.flush()


def new_id(prefix):
    return prefix + uuid.uuid4().hex[:24]


def which(name, *more):
    for path in (shutil.which(name), *more):
        if path and os.access(path, os.X_OK):
            return path
    return None


# ---- pi's tools as Claude's, and back

def drop_none(d):
    return {k: v for k, v in d.items() if v is not None}


def to_claude(name, args):
    a = args or {}
    if name == "bash":
        return "Bash", drop_none({"command": a.get("command")})
    if name in ("grep", "find", "ls"):
        return {"grep": "Grep", "find": "Glob", "ls": "LS"}[name], drop_none(dict(a))
    if name == "read":
        return "Read", drop_none({"file_path": a.get("path"), "offset": a.get("offset"), "limit": a.get("limit")})
    if name == "write":
        return "Write", drop_none({"file_path": a.get("path"), "content": a.get("content")})
    if name == "edit":
        edits = a.get("edits") or []
        if len(edits) == 1:
            return "Edit", drop_none({"file_path": a.get("path"), "old_string": edits[0].get("oldText"),
                                      "new_string": edits[0].get("newText")})
        return "MultiEdit", {"file_path": a.get("path"), "edits": [
            {"old_string": e.get("oldText"), "new_string": e.get("newText")} for e in edits]}
    return name, a


def from_claude(name, inp, was):
    """Baude's answer's input (Claude's shape) as pi's, over what pi asked with."""
    i = inp or {}
    if name == "Bash":
        return was | drop_none({"command": i.get("command")})
    if name in ("Read", "Write"):
        return was | drop_none({"path": i.get("file_path"), "offset": i.get("offset"), "limit": i.get("limit"),
                                "content": i.get("content")})
    if name == "Edit":
        return was | {"path": i.get("file_path", was.get("path")),
                      "edits": [{"oldText": i.get("old_string"), "newText": i.get("new_string")}]}
    if name == "MultiEdit":
        return was | {"path": i.get("file_path", was.get("path")),
                      "edits": [{"oldText": e.get("old_string"), "newText": e.get("new_string")}
                                for e in i.get("edits") or []]}
    return was | i


def result_text(result):
    parts = []
    for c in (result or {}).get("content") or []:
        parts.append(c.get("text", "") if c.get("type") == "text" else f"[{c.get('type', 'content')}]")
    return "\n".join(parts)


# ---- the shared server (pi-claude --serve)

@contextlib.contextmanager
def run_lock():
    os.makedirs(os.path.join(RUN, "users"), exist_ok=True)
    with open(os.path.join(RUN, "lock"), "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def keeper():
    try:
        with open(os.path.join(RUN, "server.json")) as f:
            return json.load(f).get("pid")
    except (OSError, ValueError):
        return None


def users():
    """How many chats use the server: users/<pid> files of live processes (the dead ones' cleared)."""
    n = 0
    for name in os.listdir(os.path.join(RUN, "users")):
        if name.isdigit() and pid_alive(int(name)):
            n += 1
        else:
            with contextlib.suppress(OSError):
                os.remove(os.path.join(RUN, "users", name))
    return n


class Gate:
    """Requests for the model the server has go ahead together; one for another waits for them to finish, and once
    one waits, more for the one it has wait behind it."""

    def __init__(self):
        self.cond = threading.Condition()
        self.model, self.running, self.waiting, self.last = None, 0, {}, time.time()

    @contextlib.contextmanager
    def enter(self, want):
        with self.cond:
            self.waiting[want] = self.waiting.get(want, 0) + 1
            while not (self.running == 0 or self.model == want and
                       not any(n for m, n in self.waiting.items() if m != want)):
                self.cond.wait()
            self.waiting[want] -= 1
            self.model, self.running = want, self.running + 1
        try:
            yield
        finally:
            with self.cond:
                self.running -= 1
                self.last = time.time()
                self.cond.notify_all()


def mlx_vlm_server():
    return which("mlx_vlm.server", os.path.expanduser("~/.local/bin/mlx_vlm.server"))


def serve():
    """Keep mlx_vlm.server on a port of its own, behind the gate on PORT, while chats use it."""
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        inner = s.getsockname()[1]
    os.makedirs(os.path.join(HOME, "logs"), exist_ok=True)
    log = open(os.path.join(HOME, "logs", "server.log"), "a")
    # (sh waits on its stdin, a pipe from here, and stops the server when it closes: when this exits, however)
    server = subprocess.Popen(
        ["sh", "-c", '"$@" & pid=$!; cat > /dev/null; kill $pid 2>/dev/null; wait $pid', "sh", mlx_vlm_server(),
         "--host", "127.0.0.1", "--port", str(inner), "--max-tokens", str(MAX_OUT)],
        stdin=subprocess.PIPE, stdout=log, stderr=log, env=os.environ | {"HF_HUB_OFFLINE": "1"})
    gate = Gate()

    class Proxy(http.server.BaseHTTPRequestHandler):
        def log_message(self, *_):
            pass

        def do_GET(self):
            self.forward(None)

        def do_POST(self):
            body = self.rfile.read(int(self.headers.get("Content-Length") or 0))
            try:
                want = json.loads(body).get("model")
            except ValueError:
                want = None
            if want:
                with gate.enter(want):
                    self.forward(body)
            else:
                self.forward(body)

        def forward(self, body):
            up = http.client.HTTPConnection("127.0.0.1", inner, timeout=None)
            try:
                up.request(self.command, self.path, body,
                           {k: v for k, v in self.headers.items() if k.lower() not in ("host", "connection")})
                r = up.getresponse()
                self.send_response(r.status)
                for k, v in r.getheaders():
                    if k.lower() not in ("transfer-encoding", "connection", "content-length"):
                        self.send_header(k, v)
                self.send_header("Connection", "close")
                self.end_headers()
                while chunk := r.read1(65536):  # (as it comes: a reply streams)
                    self.wfile.write(chunk)
                    self.wfile.flush()
            except OSError:
                pass  # (the chat stopped it, or the server's gone)
            finally:
                up.close()

    proxy = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Proxy)
    proxy.daemon_threads = True
    threading.Thread(target=proxy.serve_forever, daemon=True).start()
    idle_since = None
    while server.poll() is None:
        time.sleep(5)
        with gate.cond:
            unload = gate.model and not gate.running and time.time() - gate.last > UNLOAD_AFTER
            if unload:
                gate.model = None
        if unload:  # (nothing asked of it for a while: the memory back)
            with contextlib.suppress(OSError):
                urllib.request.urlopen(urllib.request.Request(f"http://127.0.0.1:{inner}/unload", method="POST"),
                                       timeout=30).read()
        with run_lock():
            if users():
                idle_since = None
                continue
            idle_since = idle_since or time.time()
            if time.time() - idle_since < IDLE:
                continue
            if keeper() == os.getpid():
                os.remove(os.path.join(RUN, "server.json"))
            break
    with run_lock():
        if keeper() == os.getpid():
            with contextlib.suppress(OSError):
                os.remove(os.path.join(RUN, "server.json"))
    proxy.server_close()
    server.stdin.close()
    server.wait(30)


def use_server():
    """Count this chat in, start the server if it isn't running, and wait until it answers."""
    if not mlx_vlm_server():
        raise RuntimeError("mlx_vlm.server isn't installed (uv tool install mlx-vlm)")
    with run_lock():
        open(os.path.join(RUN, "users", str(os.getpid())), "w").close()
        pid = keeper()
        if not (pid and pid_alive(pid)):
            pid = subprocess.Popen([sys.executable, os.path.realpath(__file__), "--serve"], start_new_session=True,
                                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL).pid
            with open(os.path.join(RUN, "server.json"), "w") as f:
                json.dump({"pid": pid, "port": PORT}, f)
            say("starting the MLX server…")
    t0 = time.time()
    while time.time() - t0 < 300:
        try:
            urllib.request.urlopen(f"http://127.0.0.1:{PORT}/v1/models", timeout=2).read()
            return
        except OSError:
            if not pid_alive(pid):
                raise RuntimeError("the MLX server stopped (see ~/.local/share/baude/pi/logs/server.log)")
            time.sleep(0.25)
    raise RuntimeError("the MLX server didn't come up in 5 minutes (see ~/.local/share/baude/pi/logs/server.log)")


def leave_server():
    with contextlib.suppress(OSError):
        os.remove(os.path.join(RUN, "users", str(os.getpid())))


def use_served():
    """A served model's server there (asked again: it may have started, or the model come, since), and Ollama's model
    loaded, its window the one it's loaded with (window)."""
    global window
    model.update(providers.resolve(model["value"]) or {})
    window = model.get("window") or window
    if model.get("error"):
        raise RuntimeError(model["error"])
    if kind != "ollama":
        return
    loaded = providers.ollama_loaded(model["url"]).get(model["repo"])
    if not loaded:
        say(f"loading {model['repo']} in Ollama…")
        try:  # (a request with no prompt loads it, and says so)
            providers.fetch(model["url"] + "/api/generate", {"model": model["repo"], "stream": False}, timeout=600)
        except (OSError, ValueError) as e:
            raise RuntimeError(f"Ollama didn't load {model['repo']}: {e}") from None
        loaded = providers.ollama_loaded(model["url"]).get(model["repo"])
    if isinstance(loaded, int) and loaded > 0:
        window = loaded
    if window < SMALL_WINDOW:
        say(f"{model['repo']} has {window:,} tokens in Ollama, too few for pi's instructions and tools: give Ollama a "
            "longer context length (its Settings, or OLLAMA_CONTEXT_LENGTH) and start it again")


def out_room(thinking):
    """The tokens a reply may have: MAX_OUT (MAX_OUT_THINKING, for one that thinks), no more than a quarter of a small
    window (half, thinking and answer together)."""
    return min(MAX_OUT_THINKING, window // 2) if thinking else min(MAX_OUT, window // 4)


def provider_config():
    """(pi's provider, its entry in pi's models.json) for the model: MLX's server, or the one serving it."""
    cost = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}
    if kind == "mlx":
        return "mlx", {
            "baseUrl": f"http://127.0.0.1:{PORT}/v1", "api": "openai-completions", "apiKey": "local",
            "compat": {"supportsDeveloperRole": False, "supportsReasoningEffort": False, "supportsStore": False,
                       "maxTokensField": "max_tokens"},
            "models": [{"id": model["repo"], "name": model["displayName"], "input": model["input"],
                        "contextWindow": CONTEXT, "cost": cost} |
                       ({"reasoning": True, "maxTokens": MAX_OUT_THINKING,  # (enable_thinking, and a budget)
                         "compat": {"thinkingFormat": "qwen", "thinkingTokenBudgetField": "thinking_budget"}}
                        if model.get("thinking") else {"maxTokens": MAX_OUT})]}
    thinks = bool(model.get("thinking"))  # (Ollama's thinking models: reasoning_effort, "none" for off)
    key = (model.get("apiKey") or "none").replace("$", "$$")  # (as it is: pi reads $NAME and a leading ! itself)
    return kind, {
        "baseUrl": model["baseUrl"], "api": "openai-completions", "apiKey": "$!" + key[1:] if key.startswith("!") else key,
        "compat": {"supportsDeveloperRole": False, "supportsStore": False, "maxTokensField": "max_tokens",
                   "supportsReasoningEffort": thinks} | ({"thinkingFormat": "openai"} if thinks else {}),
        "models": [{"id": model["repo"], "name": model["displayName"], "input": model.get("input") or ["text"],
                    "contextWindow": window, "maxTokens": out_room(thinks), "cost": cost} |
                   ({"reasoning": True, "thinkingLevelMap": {"off": "none"}} if thinks else {})]}


# ---- pi

class Engine:
    def __init__(self):
        self.lock = threading.Lock()
        self.ready = threading.Event()
        self.failed = None
        self.started = False
        self.pi = None
        self.agent_dir = None
        self.waiting = {}  # pi command id -> callback(response)
        self.asks = {}  # Baude request id -> (pi dialog id, pi tool name, pi input, Claude tool name)
        self.ids = iter(range(1, 1 << 62))
        self.queue = []
        self.turn = None

    # starting

    def start(self):
        with self.lock:
            if self.started:
                return
            self.started = True
        threading.Thread(target=self._boot, daemon=True).start()

    def _boot(self):
        try:
            use_server() if kind == "mlx" else use_served()
            self._pi()
        except Exception as e:  # noqa: BLE001 (any failure ends up as the turn's error)
            self.failed = str(e)
        self.ready.set()
        for item in self.queue:
            self.prompt(*item, again=False)
        self.queue.clear()

    def _pi(self):
        if not os.access(PI, os.X_OK):
            raise RuntimeError(f"pi isn't installed (npm install @earendil-works/pi-coding-agent, in {HOME})")
        self.agent_dir = tempfile.mkdtemp(prefix="baude-pi-")
        provider, config = provider_config()
        with open(os.path.join(self.agent_dir, "models.json"), "w") as f:
            json.dump({"providers": {provider: config}}, f)
        if window < CONTEXT:  # (a small window: pi summarises once three quarters of it's used, keeping a quarter as
            # it is, so what's left after is well under where it summarises again)
            with open(os.path.join(self.agent_dir, "settings.json"), "w") as f:
                json.dump({"compaction": {"reserveTokens": max(out_room(model.get("thinking")), window // 4),
                                          "keepRecentTokens": window // 4}}, f)
        node = which("node", os.path.expanduser("~/.local/node/bin/node"), "/opt/homebrew/bin/node")
        sessions = os.environ.get("BAUDE_PI_SESSIONS") or os.path.join(HOME, "sessions")  # (run on another host as
        # an agent: a folder of the run's own, a copy of the chat's host's to read from; what pi adds to it is sent
        # there as it's added: session.ts)
        os.makedirs(sessions, exist_ok=True)
        args = [node, os.path.realpath(PI), "--mode", "rpc", "--provider", provider, "--model", model["repo"],
                *(("--session-dir", sessions, "--session-id", session_id) if keep_session else ("--no-session",)),
                "--thinking", thinking, "--no-extensions",
                "-e", os.path.join(HERE, "ask.ts"), "--no-skills", "--no-prompt-templates", "--no-themes",
                "--no-approve", "--offline"]
        if RELAY and keep_session:
            args += ["-e", os.path.join(HERE, "session.ts")]
        servers = mcp_servers() if model.get("tools", True) else {}
        if servers:  # (pi's own MCP support, its tools declared to the model as they are, not through codemode)
            with open(os.path.join(self.agent_dir, "mcp.json"), "w") as f:
                json.dump({"mcpServers": {name: {k: v for k, v in server.items() if k in ("command", "args", "env")} |
                                          {"exposure": "direct", "timeout": MCP_TIMEOUT}
                                          for name, server in servers.items()}}, f)
            args += ["-e", "builtin:mcp"]
        else:
            args += ["--no-mcp"]
        tools = pi_tools(servers) if model.get("tools", True) else []
        if not model.get("tools", True):
            say(f"{model['displayName']} can't call tools: it only talks here")
        if tools is not None:
            args += ["--tools", ",".join(tools)] if tools else ["--no-tools"]
        if system_prompt is not None:  # (the caller's instructions, all of them: no AGENTS.md or CLAUDE.md added)
            with open(os.path.join(self.agent_dir, "system.md"), "w") as f:
                f.write(system_prompt)
            args += ["--system-prompt", os.path.join(self.agent_dir, "system.md"), "--no-context-files"]
        else:
            args += ["--append-system-prompt", f"The user's project is {cwd}, the working folder: the files they "
                     "mention are there, not in pi's own documentation."]
        os.makedirs(os.path.join(HOME, "logs"), exist_ok=True)
        log = open(os.path.join(HOME, "logs", "pi.log"), "a")
        self.pi = subprocess.Popen(args, cwd=os.getcwd(), stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=log,
                                   env=os.environ | {"PI_CODING_AGENT_DIR": self.agent_dir, "PI_OFFLINE": "1",
                                                     "PI_SKIP_VERSION_CHECK": "1", "PI_TELEMETRY": "0"})
        threading.Thread(target=self._read_pi, daemon=True).start()

    def stop(self):
        leave_server()
        if self.pi and self.pi.poll() is None:
            with contextlib.suppress(OSError):
                self.pi.stdin.close()
        if self.pi:
            try:
                self.pi.wait(3)
            except subprocess.TimeoutExpired:
                self.pi.kill()
        if self.agent_dir:
            shutil.rmtree(self.agent_dir, ignore_errors=True)

    # talking to pi

    def send(self, cmd, callback=None):
        cid = f"b{next(self.ids)}"
        if callback:
            self.waiting[cid] = callback
        with self.lock:
            self.pi.stdin.write((json.dumps(cmd | {"id": cid}) + "\n").encode())
            self.pi.stdin.flush()

    def prompt(self, text, images, again=True):
        if again and self.failed and kind != "mlx" and self.pi is None and self.turn is None:  # (its server wasn't
            self.failed, self.started = None, False  # there, or the model wouldn't load: tried again with this message)
            self.ready.clear()
        if not self.ready.is_set():
            self.queue.append((text, images))
            self.start()
            return
        busy = self.turn is not None
        if not busy:
            self.turn = {"start": time.time(), "text": "", "messages": 0, "error": None, "usage": {}}
        if self.failed:
            self.turn["error"] = self.failed
            self.end_turn()
            return
        cmd = {"type": "prompt", "message": text}
        if images:
            cmd["images"] = images
        if busy:
            cmd["streamingBehavior"] = "followUp"

        def accepted(r):
            if not r.get("success") and self.turn:
                self.turn["error"] = r.get("error") or "pi didn't take the message"
                self.end_turn()
        self.send(cmd, accepted)

    def _read_pi(self):
        for line in self.pi.stdout:
            line = line.rstrip(b"\r\n")
            if not line:
                continue
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            try:
                self.on_pi(rec)
            except Exception as e:  # noqa: BLE001 (one odd record shouldn't end the chat)
                say(f"pi-claude: {e}")
        if self.turn:
            self.turn["error"] = "pi stopped (see ~/.local/share/baude/pi/logs/pi.log)"
            self.end_turn()
        self.failed = "pi stopped"

    def on_pi(self, rec):
        t = rec.get("type")
        if t == "response":
            cb = self.waiting.pop(rec.get("id"), None)
            if cb:
                cb(rec)
        elif t == "message_start" and rec["message"].get("role") == "assistant":
            self.mid = new_id("msg_")
            self.stream({"type": "message_start", "message": {"id": self.mid, "model": model["repo"],
                                                              "role": "assistant", "content": []}})
        elif t == "message_update":
            e = rec.get("assistantMessageEvent") or {}
            i = e.get("contentIndex", 0)
            if e.get("type") == "text_start":
                self.stream({"type": "content_block_start", "index": i, "content_block": {"type": "text", "text": ""}})
            elif e.get("type") == "text_delta":
                self.stream({"type": "content_block_delta", "index": i,
                             "delta": {"type": "text_delta", "text": e.get("delta", "")}})
            elif e.get("type") == "thinking_start":
                self.stream({"type": "content_block_start", "index": i,
                             "content_block": {"type": "thinking", "thinking": ""}})
            elif e.get("type") == "thinking_delta":
                self.stream({"type": "content_block_delta", "index": i,
                             "delta": {"type": "thinking_delta", "thinking": e.get("delta", "")}})
            elif e.get("type") in ("text_end", "thinking_end"):
                self.stream({"type": "content_block_stop", "index": i})
        elif t == "message_end" and rec["message"].get("role") == "assistant":
            self.assistant_done(rec["message"])
        elif t == "tool_execution_end":
            emit({"type": "user", "parent_tool_use_id": None, "session_id": session_id,
                  "message": {"role": "user", "content": [{
                      "type": "tool_result", "tool_use_id": rec.get("toolCallId"),
                      "content": result_text(rec.get("result")), "is_error": bool(rec.get("isError"))}]}})
        elif t == "extension_ui_request":
            self.on_dialog(rec)
        elif t == "compaction_end" and rec.get("result"):
            emit({"type": "system", "subtype": "compact_boundary", "session_id": session_id})
        elif t == "agent_settled":
            self.end_turn()

    def stream(self, event):
        emit({"type": "stream_event", "event": event, "parent_tool_use_id": None, "session_id": session_id})

    def assistant_done(self, m):
        content = []
        for c in m.get("content") or []:
            if c.get("type") == "text" and c.get("text"):
                content.append({"type": "text", "text": c["text"]})
            elif c.get("type") == "thinking" and c.get("thinking"):
                content.append({"type": "thinking", "thinking": c["thinking"], "signature": ""})
            elif c.get("type") == "toolCall":
                name, inp = to_claude(c.get("name"), c.get("arguments"))
                content.append({"type": "tool_use", "id": c.get("id"), "name": name, "input": inp})
        if m.get("stopReason") == "error" and m.get("errorMessage"):
            content.append({"type": "text", "text": f"⚠ {m['errorMessage']}"})
            if self.turn:
                self.turn["error"] = m["errorMessage"]
        if not content:
            return
        u = m.get("usage") or {}
        emit({"type": "assistant", "parent_tool_use_id": None, "session_id": session_id,
              "message": {"id": getattr(self, "mid", new_id("msg_")), "model": model["repo"], "role": "assistant",
                          "content": content,
                          "stop_reason": {"length": "max_tokens", "toolUse": "tool_use", "stop": "end_turn"}.get(
                              m.get("stopReason")),  # (length: cut short, at MAX_OUT)
                          "usage": {"input_tokens": u.get("input", 0), "output_tokens": u.get("output", 0)}}})
        if self.turn:
            self.turn["messages"] += 1
            text = "".join(c["text"] for c in content if c["type"] == "text")
            if text:
                self.turn["text"] = text
            for k in ("input", "output"):
                self.turn["usage"][k] = self.turn["usage"].get(k, 0) + (u.get(k) or 0)

    def end_turn(self):
        turn, self.turn = self.turn, None
        if not turn:
            return
        if turn["error"] and not turn["text"]:
            emit({"type": "assistant", "parent_tool_use_id": None, "session_id": session_id,
                  "message": {"id": new_id("msg_"), "model": model["repo"], "role": "assistant",
                              "content": [{"type": "text", "text": f"⚠ {turn['error']}"}]}})
        emit({"type": "result", "subtype": "success", "is_error": bool(turn["error"]), "session_id": session_id,
              "result": turn["text"] or turn["error"] or "", "num_turns": max(1, turn["messages"]),
              "duration_ms": int((time.time() - turn["start"]) * 1000), "total_cost_usd": 0,
              "usage": {"input_tokens": turn["usage"].get("input", 0),
                        "output_tokens": turn["usage"].get("output", 0)}})

    # permission questions

    def on_dialog(self, rec):
        method, did = rec.get("method"), rec.get("id")
        if method == "notify" and RELAY:  # (session.ts's: what pi's added to its session, for the chat's host)
            try:
                said = json.loads(rec.get("message") or "")
            except ValueError:
                said = None
            if isinstance(said, dict) and said.get("baude") == "pi_session":
                emit({"type": "system", "subtype": "baude_pi_session", "session_id": session_id,
                      **{k: said.get(k) for k in ("header", "from", "entries")}})
            return
        ask = None
        if method == "input":
            try:
                ask = json.loads(rec.get("title") or "")
            except ValueError:
                pass
        if not isinstance(ask, dict) or ask.get("baude") != "can_use_tool":
            if method in ("select", "confirm", "input", "editor"):  # (only ask.ts's are for Baude)
                self.send({"type": "extension_ui_response", "id": did, "cancelled": True})
            return
        name, inp = to_claude(ask.get("tool"), ask.get("input"))
        if mode == "bypassPermissions":
            return self.answer(did, {"behavior": "allow"})
        rid = new_id("req_")
        self.asks[rid] = (did, ask.get("input") or {}, name)
        emit({"type": "control_request", "request_id": rid, "request": {
            "subtype": "can_use_tool", "tool_name": name, "input": inp, "tool_use_id": ask.get("id")}})

    def answer(self, did, reply):
        with self.lock:
            self.pi.stdin.write((json.dumps({"type": "extension_ui_response", "id": did,
                                             "value": json.dumps(reply)}) + "\n").encode())
            self.pi.stdin.flush()

    def on_permission(self, rid, response):
        did, was, name = self.asks.pop(rid, (None, None, None))
        if did is None:
            return
        if response.get("behavior") == "allow":
            self.answer(did, {"behavior": "allow", "input": from_claude(name, response.get("updatedInput"), was)})
        else:
            self.answer(did, {"behavior": "deny", "message": response.get("message") or "The user said no to this."})

    def deny_all(self, message):
        for rid in list(self.asks):
            self.on_permission(rid, {"behavior": "deny", "message": message})


engine = Engine()


def reply(request_id, response=None):
    emit({"type": "control_response", "response": {"subtype": "success", "request_id": request_id,
                                                   "response": response or {}}})


def handle(msg):
    global mode, thinking
    t = msg.get("type")
    if t == "control_request":
        req, rid = msg.get("request") or {}, msg.get("request_id")
        sub = req.get("subtype")
        if sub == "initialize":
            reply(rid, {"commands": [], "current_permission_mode": mode,
                        "models": [{"value": model["value"], "resolvedModel": model["repo"],
                                    "displayName": model["displayName"]}]})
            asked = [t.strip() for t in (flag("--tools") or "Read,Bash,Edit,Write").split(",") if t.strip() in PI_TOOLS]
            emit({"type": "system", "subtype": "init", "session_id": session_id, "cwd": cwd,
                  "model": model["displayName"], "tools": asked, "permissionMode": mode})
        elif sub == "get_context_usage":
            def usage(r):
                u = (r.get("data") or {}).get("contextUsage") or {}
                used, size = u.get("tokens") or 0, u.get("contextWindow") or window
                reply(rid, {"categories": [], "totalTokens": used, "maxTokens": size,
                            "percentage": used * 100 / size if size else 0})
            if engine.ready.is_set() and not engine.failed:
                engine.send({"type": "get_session_stats"}, usage)
            elif kind == "ollama" and system_prompt is not None and not engine.ready.is_set():
                engine.start()  # (Meta's: its first message is next, made to fit the window Ollama loads it with)
                threading.Thread(target=lambda: (engine.ready.wait(), usage({})), daemon=True).start()
            else:
                usage({})
        elif sub == "get_settings":
            reply(rid, {"applied": {"model": model["value"], "effort": thinking if model.get("thinking") else None}})
        elif sub == "apply_flag_settings" and "effortLevel" in (req.get("settings") or {}):
            thinking = level(req["settings"]["effortLevel"])
            if engine.ready.is_set() and not engine.failed:
                engine.send({"type": "set_thinking_level", "level": thinking})
            reply(rid)
        elif sub == "set_permission_mode":
            mode = req.get("mode") or mode
            reply(rid)
            emit({"type": "system", "subtype": "status", "status": None, "permissionMode": mode,
                  "session_id": session_id})
        elif sub == "interrupt":
            engine.deny_all("Interrupted by the user")
            if engine.ready.is_set() and not engine.failed:
                engine.send({"type": "abort"})
            reply(rid)
        else:
            reply(rid)
    elif t == "control_response":
        r = msg.get("response") or {}
        answer = r.get("response") if r.get("subtype") == "success" else None
        engine.on_permission(r.get("request_id"), answer or {"behavior": "deny", "message": "Permission denied"})
    elif t == "user":
        content = (msg.get("message") or {}).get("content")
        if isinstance(content, str):
            return engine.prompt(content, [])
        texts, images = [], []
        for b in content or []:
            if b.get("type") == "text":
                texts.append(b.get("text", ""))
            elif b.get("type") == "image" and (b.get("source") or {}).get("type") == "base64":
                images.append({"type": "image", "data": b["source"]["data"], "mimeType": b["source"]["media_type"]})
        if images and "image" not in model["input"]:
            texts.append(f"[{len(images)} image(s) {model['displayName']} can't see]")
            images = []
        engine.prompt("\n".join(texts), images)


def main():
    if "--serve" in sys.argv:
        return serve()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        for line in sys.stdin:
            line = line.strip()
            if line:
                try:
                    handle(json.loads(line))
                except ValueError:
                    pass
    finally:
        engine.stop()


if __name__ == "__main__":
    main()
