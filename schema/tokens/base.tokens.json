  "picture-shade": {
    "$description": "Someone's or a Bot's picture or initials set into the page (imageviews.shaded_picture's .picture-shade; the Android app's Avatar): three inset shadows over it, its rim darker inward and its middle as it is, light and dark alike. Over every round avatar: a picture, and initials on their colour.",
    "$extensions": {"dev.baude.android": "dp"},
    "blur": {"$type": "dimension", "$description": "The shadow all round the rim: its blur.", "$value": {"value": 4, "unit": "px"}},
    "blur-color": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.2, "hex": "#000000"},
      "$extensions": {"dev.baude.gtk": "alpha(black, 0.2)"}},
    "top-y": {"$type": "dimension", "$description": "The shadow from the top edge: how far down it's moved.", "$value": {"value": 1, "unit": "px"}},
    "top-blur": {"$type": "dimension", "$description": "The shadow from the top edge: its blur.", "$value": {"value": 2, "unit": "px"}},
    "top-color": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.28, "hex": "#000000"},
      "$extensions": {"dev.baude.gtk": "alpha(black, 0.28)"}},
    "ring": {"$type": "dimension", "$description": "The hairline ring just inside the edge: its width.", "$value": {"value": 1, "unit": "px"}},
    "ring-color": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.11, "hex": "#000000"},
      "$extensions": {"dev.baude.gtk": "alpha(black, 0.11)"}}
