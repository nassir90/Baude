<?xml version="1.0" encoding="utf-8"?>
<!-- Your Bots in the share sheet: each a sharing shortcut of this category (Shares), for what a chat's message takes -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="dev.baude.android.MainActivity">
        <data android:mimeType="text/*" />
        <data android:mimeType="image/*" />
        <data android:mimeType="application/pdf" />
        <data android:mimeType="application/json" />
        <data android:mimeType="application/xml" />
        <data android:mimeType="application/x-yaml" />
        <category android:name="dev.baude.android.category.BOT" />
    </share-target>
</shortcuts>
