{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "telemetry_read's answer, each list the earliest first (errors the latest first).",
  "properties": {
    "op": {
      "const": "telemetry_read",
      "description": "What it is."
    },
    "req": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "host": {
      "type": "string",
      "description": "The host's id."
    },
    "state": {
      "$ref": "TelemetryState.json",
      "description": "Its telemetry state."
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "TelemetryEvent.json"
      },
      "description": "Its chat events."
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "TelemetrySample.json"
      },
      "description": "Its samples."
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "TelemetryProfile.json"
      },
      "description": "Its line profiles."
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "TelemetryError.json"
      },
      "description": "The errors of the processes on its machine that happened in the stretch, the last to happen first."
    },
    "counters": {
      "type": "array",
      "items": {
        "$ref": "TelemetryCounters.json"
      },
      "description": "Its processes' counts, a row a process a minute."
    },
    "counted": {
      "type": "array",
      "items": {
        "$ref": "TelemetryCount.json"
      },
      "description": "Its processes' counts added up over the stretch, by process, kind and name, the most times first."
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "TelemetryUsage.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Its turns added up."
    },
    "truncated": {
      "type": "array",
      "items": {
        "enum": [
          "events",
          "metrics",
          "profiles",
          "counters",
          "errors",
          "counted"
        ]
      },
      "description": "Each list cut short by limit (the latest kept): a read is never cut short without saying so."
    }
  },
  "required": [
    "op",
    "host",
    "state"
  ],
  "additionalProperties": false
}
