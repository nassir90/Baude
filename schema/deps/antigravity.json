{
  "description": "Google's agy ACP agent, which runs Antigravity chats on a host.",
  "name": "Antigravity CLI",
  "where": "host",
  "needed_by": ["programs.antigravity"],
  "group": "deps.providers",
  "detect": {
    "macos": [{"env": "BAUDE_ANTIGRAVITY"}, {"which": "agy"}, {"glob": "~/.local/bin/agy"}, {"glob": "~/.antigravity/antigravity/bin/agy"}, {"glob": "~/.antigravity/bin/agy"}, {"glob": "/opt/homebrew/bin/agy"}, {"glob": "/usr/local/bin/agy"}, {"glob": "/Applications/Antigravity.app/Contents/Resources/app/bin/agy"}],
    "linux": [{"env": "BAUDE_ANTIGRAVITY"}, {"which": "agy"}, {"glob": "~/.local/bin/agy"}, {"glob": "~/.antigravity/antigravity/bin/agy"}, {"glob": "~/.antigravity/bin/agy"}, {"glob": "/usr/local/bin/agy"}, {"glob": "/usr/bin/agy"}, {"glob": "/snap/bin/agy"}]
  },
  "install": {
    "macos": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
    "debian": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
    "fedora": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
    "arch": "curl -fsSL https://antigravity.google/cli/install.sh | bash"
  },
  "link": "https://antigravity.google/docs/ide/extensions/acp/"
}
