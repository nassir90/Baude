{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "An agent's program (or a session's agent, for a head's app_tools) has started an MCP server: it's started at the other end.",
  "properties": {
    "op": {
      "const": "mcp_open",
      "description": "What it is."
    },
    "session": {
      "type": "string",
      "description": "The session (app_tools)."
    },
    "conn": {
      "type": "integer",
      "description": "Its relay's number."
    },
    "name": {
      "type": "string",
      "description": "The server's name."
    }
  },
  "required": ["op"],
  "additionalProperties": false
}
