{
  "$description": "Baude's light colours: Baude, Record and Emission's GTK CSS's, and the Android app's.",
  "libadwaita": {
    "$type": "color",
    "$description": "libadwaita's named colours, as GTK resolves them in its light style (the status colours, which libadwaita makes in Oklab, held to sRGB's range). Each token's name is libadwaita's: Baude's CSS names the colour (@sidebar_bg_color), and GTK resolves it; the Android app draws in these.",
    "sidebar_bg_color": {"$value": {"colorSpace": "srgb", "components": [0.9216, 0.9216, 0.9294], "hex": "#ebebed"}},
    "view_bg_color": {"$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}},
    "window_bg_color": {"$value": {"colorSpace": "srgb", "components": [0.9804, 0.9804, 0.9843], "hex": "#fafafb"}},
    "window_fg_color": {"$value": {"colorSpace": "srgb", "components": [0, 0, 0.0235], "alpha": 0.8, "hex": "#000006"}},
    "view_fg_color": {"$value": {"colorSpace": "srgb", "components": [0, 0, 0.0235], "alpha": 0.8, "hex": "#000006"}},
    "borders": {"$value": {"colorSpace": "srgb", "components": [0, 0, 0.0235], "alpha": 0.12, "hex": "#000006"}},
    "card_bg_color": {"$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}},
    "accent_bg_color": {"$value": "{accent.blue}"},
    "accent_fg_color": {"$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}},
    "accent_color": {"$value": {"colorSpace": "srgb", "components": [0.0157, 0.3804, 0.7451], "hex": "#0461be"}},
    "destructive_color": {"$value": {"colorSpace": "srgb", "components": [0.7647, 0, 0], "hex": "#c30000"}},
    "warning_color": {"$value": {"colorSpace": "srgb", "components": [0.5647, 0.3294, 0], "hex": "#905400"}},
    "success_color": {"$value": {"colorSpace": "srgb", "components": [0, 0.4863, 0.2392], "hex": "#007c3d"}},
    "dialog_bg_color": {"$value": {"colorSpace": "srgb", "components": [0.9804, 0.9804, 0.9843], "hex": "#fafafb"}}
  },
  "baude": {
    "$type": "color",
    "rule": {
      "$description": "Every edge: the inside's, a card's, a table's. GTK's CSS makes it as $extensions has it.",
      "$value": {"colorSpace": "srgb", "components": [0, 0, 0.0235], "alpha": 0.108, "hex": "#000006"},
      "$extensions": {"dev.baude.gtk": "alpha({libadwaita.borders}, 0.9)"}
    },
    "raised": {
      "$description": "What's raised inside the inside: a code block, a table's head.",
      "$value": {"colorSpace": "srgb", "components": [0, 0, 0.0235], "alpha": 0.048, "hex": "#000006"},
      "$extensions": {"dev.baude.gtk": "alpha({libadwaita.view_fg_color}, 0.06)"}
    }
  }
}
