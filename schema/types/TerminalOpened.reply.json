{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "The terminal's: what it is.",
  "properties": {
    "op": {
      "const": "terminal_opened",
      "description": "What it is."
    },
    "req": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "id": {
      "type": "string",
      "description": "Its id here, for attach."
    },
    "title": {
      "type": "string",
      "description": "Its title."
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What it runs."
    },
    "cwd": {
      "type": "string",
      "description": "Where it started."
    }
  },
  "required": [
    "op"
  ],
  "additionalProperties": false
}
