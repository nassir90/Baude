{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "always_allow's answer.",
  "properties": {
    "op": {
      "const": "allowed",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "session": {
      "type": "string",
      "description": "The session's id."
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All of them now, sorted."
    }
  },
  "required": ["op", "session"],
  "additionalProperties": false
}
