{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "The host's answer to hello.",
  "properties": {
    "op": {
      "const": "hello",
      "description": "What it is."
    },
    "req": {
      "type": ["integer", "null"],
      "description": "The request's number, the client's pick: its answers carry it back."
    },
    "server": {
      "$ref": "Info.json",
      "description": "What the host is."
    }
  },
  "required": ["op"],
  "additionalProperties": false
}
